#!/bin/bash
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
unset DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG KIND_EXPERIMENTAL_PROVIDER
[[ $EUID -eq 0 && $# -eq 2 ]] || exit 2
image=$1
[[ "$image" =~ ^python-webapp:sha-[a-f0-9]{40}$ ]] || { echo 'Invalid release image' >&2; exit 2; }
archive=$(realpath -e -- "$2")
case "$archive" in
  /home/priyanshu/actions-runner-day2/_work/_temp/*/daybook-image.tar) ;;
  *) echo 'Archive must be inside the runner temporary directory' >&2; exit 2 ;;
esac
[[ -f "$archive" ]] || exit 2
/usr/bin/docker load --input "$archive"
/usr/bin/docker image inspect "$image" >/dev/null
/usr/bin/kind load docker-image "$image" --name day2
